# Stripe keys — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret — for local dev, run:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# Copy the "whsec_..." secret it prints
STRIPE_WEBHOOK_SECRET=whsec_...

# Base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost.3000

# Contact email shown as iCal organizer
CONTACT_EMAIL=bookings@example.com

# Admin dashboard (/admin) login — HTTP Basic auth.
# If ADMIN_PASSWORD is not set, /admin is disabled (fails closed). Use a long random password.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
